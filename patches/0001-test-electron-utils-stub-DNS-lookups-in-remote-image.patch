From cd9e14d5ad01e60f464be56f187653039b2034ca Mon Sep 17 00:00:00 2001
From: Jakob Stender Guldberg <jakob1379@gmail.com>
Date: Tue, 6 Oct 2026 10:37:56 +0200
Subject: [PATCH 1/2] test(electron-utils): stub DNS lookups in remote-image
 tests

fetchRemoteImage screens every hop through isSafeRemoteUrl, which resolves
the hostname with node:dns/promises before the injected fetchImpl is ever
called. These tests therefore depended on a live DNS answer for
sspark.genspark.ai and failed in offline or sandboxed runs (e.g. a Nix
build). Mock the lookup to a public address; the SSRF case uses the IP
literal 127.0.0.1, which is rejected before any lookup, so it still
exercises the real guard.
---
 packages/electron-utils/tests/remote-image.test.ts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packages/electron-utils/tests/remote-image.test.ts b/packages/electron-utils/tests/remote-image.test.ts
index 3c3b7598..8a6e53f4 100644
--- a/packages/electron-utils/tests/remote-image.test.ts
+++ b/packages/electron-utils/tests/remote-image.test.ts
@@ -6,6 +6,10 @@ import {
   remoteImageHeaders,
 } from '../src/remote-image'
 
+vi.mock('node:dns/promises', () => ({
+  lookup: async () => [{ address: '93.184.215.14', family: 4 }],
+}))
+
 const png = () => new Response('img', { status: 200 })
 
 describe('remoteImageHeaders', () => {
